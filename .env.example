# Copy to `.env` and fill in. NEVER commit the filled file.

# --- Database ---
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-host-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- LLM verifier — Primary provider ---
# The pipeline tries these in order (primary → fallback 1 → fallback 2).
# Provider is auto-detected from the key prefix:
#   gsk_...   → Groq   (https://api.groq.com/openai/v1)
#   sk-or-... → OpenRouter (https://openrouter.ai/api/v1)
#   Otherwise set LLM_BASE_URL explicitly (e.g. Mistral, Together, local vLLM)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- LLM verifier — Fallback 1 ---
LLM_FALLBACK_1_API_KEY=
LLM_FALLBACK_1_BASE_URL=
LLM_FALLBACK_1_MODEL=

# --- LLM verifier — Fallback 2 ---
LLM_FALLBACK_2_API_KEY=
LLM_FALLBACK_2_BASE_URL=
LLM_FALLBACK_2_MODEL=

# --- LLM verifier — Fallback 3: Google Gemini (RESERVED / not yet load-balanced) ---
# Reserved slot for the future capacity-aware multi-provider DISTRIBUTION phase.
# Today providers are tried as a cold-standby fallback chain (primary → 1 → 2 → 3),
# NOT distributed. Filling this in will simply append Gemini as the last cold
# fallback; it is only called if every earlier provider fails.
# Gemini keys do NOT match the gsk_/sk-or- prefix auto-detection, so BASE_URL and
# MODEL below are REQUIRED (Google's OpenAI-compatible endpoint):
#   LLM_FALLBACK_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_FALLBACK_3_MODEL=gemini-2.5-flash   # confirm current model id at fill time
LLM_FALLBACK_3_API_KEY=
LLM_FALLBACK_3_BASE_URL=
LLM_FALLBACK_3_MODEL=

# --- Multi-LLM capacity-aware distribution (Phase 16+ rollout, OFF by default) ---
# When false/unset, providers are tried in strict priority order exactly as
# before (primary -> fallback 1 -> ...). Set to true to let the in-process
# ProviderScheduler pick the first provider by live RPM/TPM budget + circuit
# breaker, degrading to the fixed order whenever nothing is free (never worse).
LLM_DISTRIBUTION_ENABLED=false
# Optional overrides (defaults are conservative; see crawler/provider_scheduler.py):
#   LLM_MAX_CONCURRENT_BATCHES=3   LLM_BREAKER_FAILS=3   LLM_BREAKER_COOLDOWN_S=60
#   LLM_PRIMARY_RPM / LLM_PRIMARY_TPM / LLM_FALLBACK_<n>_RPM / LLM_FALLBACK_<n>_TPM

# --- Telegram ingestion (https://my.telegram.org/apps) ---
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_PASSWORD=
TG_SESSION_DIR=./sessions

# --- GitHub adapter (optional — raises rate limit from 60 to 5000 req/hr) ---
GITHUB_TOKEN=

# --- Discord default webhook (required for dispatch) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- Discord per-category webhooks (optional — falls back to DISCORD_WEBHOOK_URL) ---
DISCORD_WEBHOOK_LLM_API_DROP=
DISCORD_WEBHOOK_OPEN_SOURCE_REPO=
DISCORD_WEBHOOK_STUDENT_PACK=
DISCORD_WEBHOOK_SAAS_DEAL=
DISCORD_WEBHOOK_AI_TOOLS=
DISCORD_WEBHOOK_CODING_AGENTS=
DISCORD_WEBHOOK_CLOUD=
DISCORD_WEBHOOK_COUPON=

# --- Deep web search (optional — DDG is default and free) ---
SERPER_API_KEY=
DEEP_WEB_ENGINE=ddg

# --- Dashboard ---
DASHBOARD_API_KEY=