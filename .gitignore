# Secrets — NEVER commit
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Telegram sessions
sessions/
*.session
*.session-journal

# Social-stealth browser identities — live session cookies + fingerprint.
# NEVER commit: anyone with a *.state.json can impersonate the logged-in account.
# Covers the default ./identities dir and any IDENTITY_DIR override location.
identities/
*.state.json

# Local tooling
.ruff_cache/
.mypy_cache/

# graphify knowledge-graph cache — content-hashed AST/semantic blobs, rewritten
# on every run. The graph outputs (graph.json, graph.html, GRAPH_REPORT.md) stay
# tracked; only this churn-heavy cache is ignored.
graphify-out/cache/
